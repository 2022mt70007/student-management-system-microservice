# Copy to .env and fill in your values (never commit .env)

# AWS SES SMTP (region must match where you created SMTP credentials)
SES_MAIL_HOST=email-smtp.ap-south-1.amazonaws.com
SES_MAIL_PORT=587
SES_SMTP_USERNAME=your-ses-smtp-username
SES_SMTP_PASSWORD=your-ses-smtp-password

# Set to true when using AWS SES (port 587)
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true

# Email verified in AWS SES
MAIL_FROM=your-verified@gmail.com

# Optional: field encryption for student/teacher/admin services
# APP_ENCRYPTION_KEY=your-32-byte-key
