# Copy to .env and fill in your values (never commit .env)

# --- Local dev (MailHog — default when using docker compose) ---
# MailHog UI: http://localhost:8025
# No .env needed for local; docker-compose defaults to mailhog:1025.
# Optional explicit local overrides:
# MAIL_HOST=mailhog
# MAIL_PORT=1025
# MAIL_SMTP_AUTH=false
# MAIL_SMTP_STARTTLS=false
# MAIL_FROM=noreply@sms.local
# BOOTSTRAP_ADMIN_EMAIL=you@gmail.com

# --- AWS SES (production / cloud VM) ---
# SES_MAIL_HOST=email-smtp.ap-south-1.amazonaws.com
# SES_MAIL_PORT=587
# SES_SMTP_USERNAME=your-ses-smtp-username
# SES_SMTP_PASSWORD=your-ses-smtp-password
# MAIL_SMTP_AUTH=true
# MAIL_SMTP_STARTTLS=true
# MAIL_FROM=your-verified@gmail.com

# Cloud deploy — set to your VM external IP
REGISTRATION_BASE_URL=http://YOUR_VM_IP:5173/register
APP_SECURITY_ALLOWED_ORIGINS=http://YOUR_VM_IP:5173

# Strong secrets for cloud (generate new values)
JWT_SECRET=change-to-long-random-string
APP_ENCRYPTION_KEY=change-to-32-byte-key

# Optional: field encryption for student/teacher/admin services
# APP_ENCRYPTION_KEY=your-32-byte-key
